  },
  "components": {
    "schemas": {
      "CampusDto": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ChangePasswordRequest": {
        "required": [
          "currentPassword",
          "newPassword",
          "newPasswordAgain"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": [
              "null",
              "string"
            ]
          },
          "newPassword": {
            "type": [
              "null",
              "string"
            ]
          },
          "newPasswordAgain": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "InstitutionDto": {
        "required": [
          "id",
          "name",
          "campuses"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "campuses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CampusDto"
            }
          }
        }
      },
      "LoginRequest": {
        "required": [
          "institutionCode",
          "email",
          "password",
          "client"
        ],
        "type": "object",
        "properties": {
          "institutionCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          },
          "client": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "LoginStepRequest": {
        "required": [
          "step"
        ],
        "type": "object",
        "properties": {
          "step": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "LoginStepResponse": {
        "required": [
          "next",
          "step",
          "stepExpiresAt"
        ],
        "type": "object",
        "properties": {
          "next": {
            "type": "string"
          },
          "step": {
            "type": "string"
          },
          "stepExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RecoveryCodesResponse": {
        "required": [
          "recoveryCodes"
        ],
        "type": "object",
        "properties": {
          "recoveryCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RefreshRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SessionInfo": {
        "required": [
          "roles",
          "sessionExpiresAt"
        ],
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sessionExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SessionResponse": {
        "required": [
          "roles",
          "accessExpiresAt",
          "sessionExpiresAt",
          "accessToken",
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accessExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "sessionExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "accessToken": {
            "type": [
              "null",
              "string"
            ]
          },
          "refreshToken": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SetupCompletedResponse": {
        "required": [
          "session",
          "recoveryCodes"
        ],
        "type": "object",
        "properties": {
          "session": {
            "$ref": "#/components/schemas/SessionResponse"
          },
          "recoveryCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "TwoFactorCodeRequest": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TwoFactorEnableResponse": {
        "required": [
          "step",
          "key",
          "qrCode"
        ],
        "type": "object",
        "properties": {
          "step": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "qrCode": {
            "type": "string"
          }
        }
      },
      "TwoFactorSetupResponse": {
        "required": [
          "key",
          "qrCode"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "qrCode": {
            "type": "string"
          }
        }
      },
      "TwoFactorStatusResponse": {
        "required": [
          "enabled",
          "required",
          "canDisable",
          "remainingRecoveryCodes"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "canDisable": {
            "type": "boolean"
          },
          "remainingRecoveryCodes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "VerifyLoginRequest": {
        "required": [
          "step",
          "code",
          "recoveryCode"
        ],
        "type": "object",
        "properties": {
          "step": {
            "type": [
              "null",
              "string"
            ]
          },
          "code": {
            "type": [
              "null",
              "string"
            ]
          },
          "recoveryCode": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Institution"
    },
    {
      "name": "Auth"
    }
  ]
}